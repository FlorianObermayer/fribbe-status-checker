{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "lint",
            "type": "shell",
            "command": "uv run lint",
            "problemMatcher": [
                "$python"
            ]
        },
        {
            "label": "lint & fix",
            "type": "shell",
            "command": "uv run lint --fix",
            "problemMatcher": [
                "$python"
            ]
        },
        {
            "label": "create release",
            "type": "shell",
            "command": "uv run release",
            "problemMatcher": [
                "$python"
            ]
        },
        {
            "label": "generate licenses",
            "type": "shell",
            "command": "uv run generate-licenses",
            "problemMatcher": [
                "$python"
            ]
        },
        {
            "label": "Update deps",
            "type": "shell",
            "command": "uv lock --upgrade && uv sync --upgrade && uv run generate-licenses && uv run security-check && uv run test",
            "problemMatcher": [
                "$python"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Refresh the uv lockfile, sync the environment, regenerate app/licenses.json, run the security-check, and run the full test suite."
        }
    ]
}
